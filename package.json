{
  "name": "basic-pr-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.18.0 <25" },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
